import ipaddress #o pacote ipaddress é usado para manipular endereços IP e redes nativamente em Python.

print("Calculadora de redes")
print("Digite o endereço IP e a máscara de rede no formato CIDR (ex: 192.168.1.50/24)")
user_input = input("Digite o endereço IP e a máscara de rede: ")

#checar se o input é válido

ip = ipaddress.ip_interface(user_input) #definir a variável ip como o endereço IP e a máscara de rede fornecidos pelo usuário

if ip.version !=4 : #se não for IPv4 ou se não tiver endereço de broadcast, printar mensagem de erro
    print("Endereço IP inválido. Por favor, insira um endereço IPv4 válido.")
else: # se for IPv4 e tiver endereço de broadcast, printar informações da rede
    rede = ip.network  # a propriedade network retorna a rede associada ao endereço IP fornecido

#definindo variáveis para armazenar informações da rede 
rede_list = list(rede.hosts()) # esta variável armazena todos os endereços IP disponíveis na rede, excluindo o endereço de rede e o endereço de broadcast
rede_list_0 = f"Primeiro host: {rede_list[0]}" # o primeiro host é o primeiro endereço IP disponível na rede sendo 0
rede_list_minus1 = f"Último host: {rede_list[-1]}" # o último host é o último endereço IP disponível na rede sendo -1
rede_address_netmask = f"Máscara de rede: {rede.netmask}" #a máscara de rede é a máscara de sub-rede associada à rede, que é usada para determinar quais endereços IP pertencem à rede e quais não pertencem
rede_address_network = f"Endereço de rede: {rede.network_address}" #o endereço de rede é o primeiro endereço IP da rede, que é usado para identificar a rede como um todo
rede_address_numbers = f"Número de endereços: {rede.num_addresses - 2}" # é necessário subtrair 2 do número de endereços para excluir o endereço de rede e o endereço de broadcast
rede_address_broadcast = f"Endereço de broadcast: {rede.broadcast_address}"#o endereço de broadcast é o último endereço IP da rede, que é usado para enviar pacotes para todos os dispositivos na rede

#listando as informações da rede em uma lista para facilitar a impressão e leitura
rede_map = [
    rede_address_netmask, 
    rede_address_network,
    rede_address_numbers, 
    rede_address_broadcast, 
    rede_list_0, 
    rede_list_minus1]

#loop para imprimir as informações da rede
for i in rede_map:
    print(i)







